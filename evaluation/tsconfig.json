{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "baseline/**/*.ts",
    "generalization/**/*.ts",
    "generator/**/*.ts",
    "ml/**/*.ts",
    "recovery/**/*.ts",
    "scripts/**/*.ts"
  ]
}
