{
  "name": "flowguard-recoverypilot",
  "private": true,
  "version": "0.1.0",
  "description": "FlowGuard RecoveryPilot 2.0 for the Razorpay AI Buildathon",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @flowguard/recovery && npm run build --workspaces",
    "dev:api": "npm --workspace @flowguard/api run dev",
    "dev:web": "npm --workspace @flowguard/web run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-data": "tsx evaluation/scripts/generate-data.ts",
    "generate:generalization-data": "tsx evaluation/scripts/generate-generalization-data.ts",
    "evaluate:baseline": "tsx evaluation/baseline/run-baseline.ts",
    "evaluate:ml": "tsx evaluation/ml/run-experiment.ts",
    "evaluate:generalization": "tsx evaluation/generalization/run-generalization.ts",
    "evaluate:recovery": "tsx evaluation/recovery/batch.ts",
    "evaluate:recovery-value": "tsx evaluation/recovery-value/run-value-evaluation.ts",
    "lint": "eslint .",
    "test": "npm run build --workspace @flowguard/recovery && vitest run",
    "typecheck": "npm run build --workspace @flowguard/recovery && npm run typecheck --workspaces && npm run typecheck:evaluation",
    "typecheck:evaluation": "tsc --noEmit -p evaluation/tsconfig.json",
    "validate-data": "tsx evaluation/scripts/validate-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
